surface WorkflowCapabilityReadOnlySurface {
    -- WorkflowCapability.ReadOnly: universal, read-only tier.
    facing _: UserCode
    context u: WorkflowCapability where u.authority = read_only

    provides:
        WorkflowCapabilityApplied(u, instance_id)

    contracts:
        demands JsonCodec
        fulfils WorkflowReadOnlyOperations
}

surface WorkflowCapabilitySurface {
    -- WorkflowCapability: universal, full tier (extends WorkflowCapability.ReadOnly).
    facing _: UserCode
    context u: WorkflowCapability where u.authority = full

    provides:
        WorkflowCapabilityApplied(u, instance_id)

    contracts:
        demands JsonCodec
        fulfils WorkflowReadOnlyOperations
        fulfils WorkflowOperations
}

surface WorkflowInstanceReadOnlySurface {
    -- WorkflowCapability.Instance.ReadOnly: bound to instance_id, read-only tier.
    facing _: UserCode
    context cap: WorkflowCapabilityInstance where cap.authority = read_only

    exposes:
        cap.instance_id

    contracts:
        demands JsonCodec
        fulfils WorkflowInstanceReadOnlyOperations
}

surface WorkflowInstanceSurface {
    -- WorkflowCapability.Instance: bound to instance_id, full tier (extends WorkflowCapability.Instance.ReadOnly).
    facing _: UserCode
    context cap: WorkflowCapabilityInstance where cap.authority = full

