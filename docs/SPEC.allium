-- ---- Actor (dapr4s.actor) ----

surface ActorCapabilitySurface {
    -- ActorCapability: universal; apply(actor_type) -> ActorCapability.Type^{this}.
    facing _: UserCode
    context u: ActorCapability

    provides:
        ActorCapabilityApplied(u, actor_type)

    contracts:
        demands JsonCodec
        fulfils ActorOperations
}

surface ActorTypeSurface {
    -- ActorCapability.Type: bound to actor_type; apply(actor_id) -> ActorCapability.Instance^{this}.
    facing _: UserCode
    context t: ActorCapabilityType

    exposes:
        t.actor_type

    provides:
        ActorTypeApplied(t, actor_id)

    contracts:
        demands JsonCodec
        fulfils ActorTypeOperations
}

surface ActorInstanceSurface {
    -- ActorCapability.Instance: bound to actor_type and actor_id.
    facing _: UserCode
    context cap: ActorCapabilityInstance

    exposes:
        cap.actor_type
        cap.actor_id

    contracts:
        demands JsonCodec
        fulfils ActorInstanceOperations
}

