        cap.instance_id

    contracts:
        demands JsonCodec
        fulfils WorkflowInstanceReadOnlyOperations
        fulfils WorkflowInstanceOperations
}

-- ---- Jobs (dapr4s.jobs) ----

surface JobsCapabilityReadOnlySurface {
    -- JVM only. JobsCapability.ReadOnly: universal, read-only tier.
    facing _: UserCode
    context u: JobsCapability where u.authority = read_only

    provides:
        JobsCapabilityApplied(u, job_name)

    contracts:
        demands JsonCodec
        fulfils JobsReadOnlyOperations
}

surface JobsCapabilitySurface {
    -- JVM only. JobsCapability: universal, full tier (extends JobsCapability.ReadOnly).
    facing _: UserCode
    context u: JobsCapability where u.authority = full

    provides:
        JobsCapabilityApplied(u, job_name)

    contracts:
        demands JsonCodec
        fulfils JobsReadOnlyOperations
        fulfils JobsOperations
}

surface JobsInstanceReadOnlySurface {
    -- JVM only. JobsCapability.Instance.ReadOnly: bound to job_name, read-only tier.
    facing _: UserCode
    context cap: JobsCapabilityInstance where cap.authority = read_only

    exposes:
        cap.job_name

    contracts:
        demands JsonCodec
        fulfils JobsInstanceReadOnlyOperations
}

surface JobsInstanceSurface {
    -- JVM only. JobsCapability.Instance: bound to job_name, full tier (extends JobsCapability.Instance.ReadOnly).
    facing _: UserCode
    context cap: JobsCapabilityInstance where cap.authority = full

    exposes:
        cap.job_name

    contracts:
        demands JsonCodec
        fulfils JobsInstanceReadOnlyOperations
        fulfils JobsInstanceOperations
}

-- ---- Conversation (dapr4s.conversation) ----

surface ConversationCapabilitySurface {
    -- JVM only. ConversationCapability: universal; apply(component_name) -> ConversationCapability.Instance^{this}.
    facing _: UserCode
    context u: ConversationCapability

    provides:
        ConversationCapabilityApplied(u, component_name)

    contracts:
        fulfils ConversationOperations
}

surface ConversationInstanceSurface {
    -- JVM only. ConversationCapability.Instance: bound to component_name; its operations never take it.
    facing _: UserCode
    context cap: ConversationCapabilityInstance

    exposes:
        cap.component_name

    contracts:
        fulfils ConversationInstanceOperations
}

surface ActorContextSurface {
    -- Capability injected into every actor invocation by the framework.
    -- UserCode methods call ActorContext.get/set/etc. via companion-object forwarders
    -- (static-dispatch pattern) rather than naming the capability value.
    facing user: UserCode

    contracts:
        demands JsonCodec
        fulfils ActorContextOperations

    @guarantee ActorStateIsolation
        -- State operations (get, set, remove) are scoped to the specific (actorType, actorId) pair.
        -- No actor instance can read or write state belonging to a different actor ID.
        -- Enforced at runtime: ActorContext is constructed with (actorType, actorId) and all
        -- HTTP calls to the Dapr actor state API include those identifiers in the path.

    @guarantee ReminderPersistence
        -- Registered reminders survive actor deactivation and JVM restart.
        -- The Dapr sidecar stores reminder metadata; upon dueTime the sidecar reactivates the
        -- actor and delivers the reminder via PUT /actors/{type}/{id}/method/remind/{name}.

    @guarantee TimerNonPersistence
        -- Registered timers are NOT persisted across actor deactivation.
        -- If the actor is deactivated before dueTime the timer is silently dropped.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Should Dapr support a custom DaprClient (e.g. for testing without sidecar)?"
-- Current design always creates a fresh client via DaprClientBuilder (JVM) from DaprConfig.
-- An override for tests would allow passing a mock client.

-- RESOLVED: StateCapability exposes queryState via DAPR state query API.
-- Note: not all state store components support queries.

-- RESOLVED: PublishCapability supports bulkPublish via BulkPublishEntry / BulkPublishResult.

-- RESOLVED: ETagMismatchException extends Exception directly (DaprStateException was removed).
-- It is the only exception declared for state operations; callers catch it to handle
-- optimistic-concurrency conflicts (fetch new ETag, retry).
