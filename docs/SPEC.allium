-- ---- Bindings (dapr4s.bindings) ----

surface BindingsCapabilitySurface {
    -- BindingsCapability: universal; apply(binding_name) -> BindingsCapability.Instance^{this}.
    facing _: UserCode
    context u: BindingsCapability

