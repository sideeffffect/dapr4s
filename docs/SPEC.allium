    exposes:
        cap.store_name

    provides:
        SecretsGetRequested(cap, key, metadata)
        SecretsGetBulkRequested(cap, metadata)

    contracts:
        fulfils SecretsInstanceReadOnlyOperations
        fulfils SecretsInstanceOperations
}

-- ---- Configuration (dapr4s.configuration) ----

surface ConfigurationCapabilityReadOnlySurface {
    -- ConfigurationCapability.ReadOnly: universal, read-only tier.
