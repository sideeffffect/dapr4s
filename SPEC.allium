-- allium: 3
-- SPEC.allium — scala-safe-dapr behavioural specification
--
-- Scope: Safe Scala capability library wrapping DAPR building blocks
-- Includes: DaprRuntime lifecycle (run + serve), StateCapability, PubSubCapability,
--           ServiceInvocationCapability, SecretsCapability,
--           ConfigurationCapability (get + subscribe), BindingsCapability,
--           DistributedLockCapability, DaprApp (inbound pub/sub, bindings,
--           service invocation), JsonCodec
-- Excludes:
--   - DAPR actor framework (separate concern)
--   - DAPR workflow orchestration (separate concern)
--   - DAPR sidecar itself (external system)
--   - Authentication and mTLS (managed by DAPR sidecar)
-- Dependencies: DAPR sidecar must be running and reachable

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity DaprSidecar {
    host: String
    port: Integer
    app_id: String
    reachable: Boolean
}

external entity JavaDaprClient {
    -- Managed entirely inside @assumeSafe boundaries; opaque to user code
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value StoreName {
    value: String
}

value PubSubName {
    value: String
}

value Topic {
    value: String
}

value AppId {
    value: String
}

value SecretStoreName {
    value: String
}

value ConfigStoreName {
    value: String
}

value BindingName {
    value: String
}

value ETag {
    value: String
}

value ConfigItem {
    key: String
    value: String
    version: String
    metadata: Map<String, String>
}

value StateEntry<T> {
    value: T?
    etag: ETag?
    -- etag is present iff value is present
}

value StateQuery {
    -- Opaque query expression passed to the state store query API.
    -- Format depends on the state store component (e.g. JSON filter object).
    query: String
}

value BulkPublishEntry<T> {
    entry_id: String    -- caller-assigned ID for correlating failures
    event: T
}

value BulkPublishResult {
    failed_entries: List<String>
    -- IDs of entries that failed to publish; empty on full success
}

value UnlockStatus {
    -- Result of a distributed lock unlock operation.
    status: success | lock_not_found | internal_error
    -- success:       lock was held by lockOwner and has been released
    -- lock_not_found: no lock exists for the given resourceId
    -- internal_error: lock exists but is held by a different owner
}

value SubscriptionResult {
    -- What a pub/sub subscription handler returns to the sidecar.
    outcome: success | retry | drop
    -- success: ACK — do not redeliver
    -- retry:   NAK — redeliver after the configured retry interval
    -- drop:    silently discard — do not redeliver, no error
}

value CloudEvent<T> {
    id: String
    source: String
    spec_version: String
    type: String
    topic: String
    pub_sub_name: String
    data_content_type: String
    data: T
}

variant StateOp {
    -- Sealed ADT matching the code's sealed trait StateOp.
    -- UpsertOp always carries encoded_value (structurally non-nullable).
    UpsertOp {
        key: String
        encoded_value: String   -- pre-encoded JSON value; always present
        etag: ETag?
    }
    DeleteOp {
        key: String
        etag: ETag?
    }
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract JsonCodec {
    -- Typeclass contract: a T with a JsonCodec can be
    -- serialised to/from JSON string form.
    encode: (value: Any) -> String
    decode: (json: String?) -> DecodeResult
    -- decode accepts null input; returns Left(JsonDecodeException("null input")) for null
    decode_or_throw: (json: String?) -> Any throws JsonDecodeException
    -- Convenience: unwraps Right or throws the JsonDecodeException from Left

    @invariant Roundtrip
        -- For any value v where encode and decode are defined:
        -- decode(encode(v)) = Right(v)

    @invariant EncodeTotal
        -- encode never throws; it always returns a String.

    @invariant DecodeNeverThrows
        -- decode always returns Left or Right; it never throws.
        -- decode(null) returns Left(JsonDecodeException("null input")).
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

-- (none at module level; StateOp variants are declared in Value Types above)

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity DaprRuntime {
    -- Singleton runtime; at most one active at a time in a given thread scope
    status: idle | active | closed
    client: JavaDaprClient?
    -- client is present iff status = active
}

entity DaprScope {
    runtime: DaprRuntime
    status: open | closed
    -- A DaprScope is created by DaprRuntime.run (or serve) and closed when the block exits.
    -- Capabilities derived from a scope share its lifetime.
}

entity DaprApp {
    -- Immutable, declarative description of all inbound handlers an application exposes.
    -- Built by the serve body and handed to the HTTP server; never mutated after construction.
    subscriptions: List<Subscription>
    invocations:   List<InvocationRoute>
    bindings:      List<BindingRoute>
    workflows:     List<DaprWorkflow>
    activities:    List<DaprActivity>
    -- Two DaprApp values may be combined with ++ to compose service modules.
}

entity Subscription {
    pubsub_name: PubSubName
    topic:       Topic
    route:       Route
    -- handler: CloudEvent -> SubscriptionResult (captured, CC-erased internally)
}

entity InvocationRoute {
    method_name: MethodName
    -- handler: Req -> Resp (captured, CC-erased internally)
}

entity BindingRoute {
    binding_name: BindingName
    -- handler: Payload -> Unit (captured, CC-erased internally)
}

entity StateCapability {
    scope: DaprScope
    store_name: StoreName
    status: open | closed
    -- status mirrors scope.status
}

entity PubSubCapability {
    scope: DaprScope
    pubsub_name: PubSubName
    status: open | closed
}

entity ServiceInvocationCapability {
    scope: DaprScope
    status: open | closed
}

entity SecretsCapability {
    scope: DaprScope
    store_name: SecretStoreName
    status: open | closed
}

entity ConfigurationCapability {
    scope: DaprScope
    store_name: ConfigStoreName
    status: open | closed
}

entity BindingsCapability {
    scope: DaprScope
    binding_name: BindingName
    status: open | closed
}

entity DistributedLockCapability {
    scope: DaprScope
    store_name: StoreName
    status: open | closed
}

entity DecodeResult {
    -- Represents Either[JsonDecodeException, T] from JsonCodec.decode
    outcome: success | failure
    value: Any?                   -- present when outcome = success
    error: JsonDecodeException?   -- present when outcome = failure
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- ---- Runtime Lifecycle ----

rule DaprRuntimeActivates {
    when: DaprRun()
    -- DaprRun() is the user calling DaprRuntime.run { body }

    requires: DaprRuntime.status = idle

    ensures:
        DaprRuntime.status = active
        DaprRuntime.client = JavaDaprClient.created()
        DaprScope.created(runtime: DaprRuntime, status: open)
}

rule DaprRuntimeCompletes {
    when: DaprBodyCompleted()
    -- Body function returned normally

    requires: DaprRuntime.status = active

    ensures:
        DaprScope.status = closed
        DaprRuntime.client = absent
        DaprRuntime.status = idle
        JavaDaprClientClosed()
        -- All capabilities derived from this scope become closed
}

rule DaprRuntimeFailsSafely {
    when: DaprBodyThrew(exception)
    -- Body function threw an exception

    requires: DaprRuntime.status = active

    ensures:
        DaprScope.status = closed
        DaprRuntime.client = absent
        DaprRuntime.status = idle
        JavaDaprClientClosed()
        -- Exception propagates to caller after cleanup
        ExceptionPropagated(exception: exception)
}

-- ---- Capability Acquisition ----

rule StateCapabilityAcquired {
    when: DaprScopeStateRequested(scope, store_name)

    requires: scope.status = open

    ensures:
        StateCapability.created(
            scope: scope,
            store_name: store_name,
            status: open
        )
}

rule PubSubCapabilityAcquired {
    when: DaprScopePubSubRequested(scope, pubsub_name)

    requires: scope.status = open

    ensures:
        PubSubCapability.created(
            scope: scope,
            pubsub_name: pubsub_name,
            status: open
        )
}

rule ServiceInvocationCapabilityAcquired {
    when: DaprScopeInvokerRequested(scope)

    requires: scope.status = open

    ensures:
        ServiceInvocationCapability.created(
            scope: scope,
            status: open
        )
}

rule SecretsCapabilityAcquired {
    when: DaprScopeSecretsRequested(scope, store_name)

    requires: scope.status = open

    ensures:
        SecretsCapability.created(
            scope: scope,
            store_name: store_name,
            status: open
        )
}

rule ConfigCapabilityAcquired {
    when: DaprScopeConfigRequested(scope, store_name)

    requires: scope.status = open

    ensures:
        ConfigurationCapability.created(
            scope: scope,
            store_name: store_name,
            status: open
        )
}

rule BindingCapabilityAcquired {
    when: DaprScopeBindingRequested(scope, binding_name)

    requires: scope.status = open

    ensures:
        BindingsCapability.created(
            scope: scope,
            binding_name: binding_name,
            status: open
        )
}

rule LockCapabilityAcquired {
    when: DaprScopeLockRequested(scope, store_name)

    requires: scope.status = open

    ensures:
        DistributedLockCapability.created(
            scope: scope,
            store_name: store_name,
            status: open
        )
}

-- ---- Capability Closure (cascade from scope) ----

rule CapabilitiesClosedWithScope {
    when: scope: DaprScope.status = closed

    ensures:
        for cap in StateCapability where cap.scope = scope:
            cap.status = closed
        for cap in PubSubCapability where cap.scope = scope:
            cap.status = closed
        for cap in ServiceInvocationCapability where cap.scope = scope:
            cap.status = closed
        for cap in SecretsCapability where cap.scope = scope:
            cap.status = closed
        for cap in ConfigurationCapability where cap.scope = scope:
            cap.status = closed
        for cap in BindingsCapability where cap.scope = scope:
            cap.status = closed
        for cap in DistributedLockCapability where cap.scope = scope:
            cap.status = closed
}

-- ---- State Operations ----

rule StateGet {
    when: StateGetRequested(cap, key)

    requires: cap.status = open

    ensures:
        -- Either returns a value or absent; throws DaprException on DAPR error
        StateGetCompleted(result: StateEntry.created(value: any, etag: any))
}

rule StateSave {
    when: StateSaveRequested(cap, key, value)

    requires: cap.status = open

    ensures:
        StateSaveCompleted()
        -- DAPR stores the value at key in store cap.store_name
}

rule StateSaveWithETag {
    when: StateSaveWithETagRequested(cap, key, value, etag)

    requires: cap.status = open

    ensures:
        if DaprETagMatches(cap.store_name, key, etag):
            StateSaveCompleted()
        else:
            ETagMismatchExceptionThrown(key: key, etag: etag)
}

rule StateDelete {
    when: StateDeleteRequested(cap, key)

    requires: cap.status = open

    ensures:
        StateDeleteCompleted()
}

rule StateDeleteWithETag {
    when: StateDeleteWithETagRequested(cap, key, etag)

    requires: cap.status = open

    ensures:
        if DaprETagMatches(cap.store_name, key, etag):
            StateDeleteCompleted()
        else:
            ETagMismatchExceptionThrown(key: key, etag: etag)
}

rule StateTransaction {
    when: StateTransactionRequested(cap, ops)

    requires: cap.status = open
    requires: ops.count > 0
    -- UpsertOp.encoded_value is structurally always present (non-nullable by construction)

    ensures:
        -- All ops applied atomically; on any failure all are rolled back
        if DaprTransactionSucceeds(cap.store_name, ops):
            StateTransactionCompleted()
        else:
            DaprExceptionThrown()
}

-- ---- PubSub Operations ----

rule PubSubPublish {
    when: PubSubPublishRequested(cap, topic, data)

    requires: cap.status = open

    ensures:
        -- Fire-and-forget from caller's perspective; DAPR delivers at-least-once
        PubSubPublishCompleted()
        -- Note: delivery to subscribers is asynchronous and not tracked here
}

-- ---- Service Invocation ----

rule ServiceInvoke {
    when: ServiceInvokeRequested(cap, app_id, method, data)

    requires: cap.status = open

    ensures:
        if DaprServiceResponds(app_id, method):
            ServiceInvokeCompleted(response: any)
        else:
            DaprExceptionThrown()
}

-- ---- Secrets ----

rule SecretsGet {
    when: SecretsGetRequested(cap, key)

    requires: cap.status = open

    ensures:
        if DaprSecretExists(cap.store_name, key):
            SecretsGetCompleted(value: String)
        else:
            DaprExceptionThrown()
}

rule SecretsGetBulk {
    when: SecretsGetBulkRequested(cap)

    requires: cap.status = open

    ensures:
        SecretsGetBulkCompleted(values: Map<String, String>)
}

-- ---- Configuration ----

rule ConfigGet {
    when: ConfigGetRequested(cap, keys)

    requires: cap.status = open
    -- empty keys list is accepted; returns empty map

    ensures:
        ConfigGetCompleted(items: Map<String, ConfigItem>)
}

rule ConfigSubscribe {
    when: ConfigSubscribeRequested(cap, keys, on_change)
    -- on_change is a callback invoked on every config update from the sidecar

    requires: cap.status = open

    ensures:
        ConfigSubscriptionCreated(
            cap: cap,
            keys: keys,
            subscription: AutoCloseable
        )
        -- subscription.close() stops the streaming subscription
        -- on_change is called on a background thread for each update
        -- If the scope is closed, the subscription is implicitly stopped
}

-- ---- Inbound Dispatch (DaprApp) ----
-- DaprApp is immutable and fully described before the HTTP server starts.
-- Registration is implicit: DaprAppServer derives routes from DaprApp at startup.

rule DaprAppServed {
    when: DaprRuntime.serve returns DaprApp

    ensures:
        for s in app.subscriptions:
            PubSubSubscription.registered(
                pubsub_name: s.pubsub_name,
                topic: s.topic,
                route: s.route
            )
        for inv in app.invocations:
            InvocationHandler.registered(path: "/" + inv.method_name)
        for bin in app.bindings:
            BindingHandler.registered(path: "/" + bin.binding_name)
        -- GET /dapr/subscribe returns all registered subscriptions
}

-- ---- Inbound Dispatch (during serving) ----

rule PubSubMessageDelivered {
    when: SidecarDeliversPubSubMessage(route, cloud_event_json)
    -- Sidecar POSTs to <route> with a CloudEvent JSON body

    ensures:
        let cloud_event = ParseCloudEvent(cloud_event_json)
        if cloud_event.data decode fails:
            -- Returns {"status":"DROP"} to sidecar; message silently discarded
            SubscriptionResult.drop
        else:
            let result = handler(cloud_event)
            -- Returns {"status":"SUCCESS"}, {"status":"RETRY"}, or {"status":"DROP"}
            result
        if handler throws:
            SubscriptionResult.retry
}

rule BindingEventDelivered {
    when: SidecarDeliversBindingEvent(binding_name, payload)

    ensures:
        if handler(payload) succeeds:
            HTTP 200 returned to sidecar
        if handler throws:
            HTTP 500 returned to sidecar

}

rule ServiceInvocationReceived {
    when: SidecarDeliversInvocation(method_name, request_body)

    ensures:
        if handler(request) succeeds:
            HTTP 200 with response JSON returned
        if handler throws:
            HTTP 500 returned to sidecar

}

-- ---- Distributed Lock ----

rule LockTryLock {
    when: LockTryLockRequested(cap, resourceId, lockOwner, expirySeconds)

    requires: cap.status = open

    ensures:
        if DaprLockAvailable(cap.store_name, resourceId):
            LockAcquired(resourceId: resourceId, owner: lockOwner)
            -- Returns true
        else:
            -- Returns false; no exception
}

rule LockUnlock {
    when: LockUnlockRequested(cap, resourceId, lockOwner)

    requires: cap.status = open

    ensures:
        if DaprLockExists(cap.store_name, resourceId):
            if DaprLockOwner(cap.store_name, resourceId) = lockOwner:
                LockReleased(resourceId: resourceId)
                -- Returns UnlockStatus.Success
            else:
                -- Returns UnlockStatus.InternalError (wrong owner)
        else:
            -- Returns UnlockStatus.LockNotFound

}

-- ---- Output Bindings ----

rule BindingInvoke {
    when: BindingInvokeRequested(cap, operation, data)

    requires: cap.status = open

    ensures:
        if DaprBindingResponds(cap.binding_name, operation):
            BindingInvokeCompleted(response: any)
        else:
            DaprExceptionThrown()
}

-- ---- JsonCodec ----

rule JsonEncode {
    when: JsonEncodeRequested(value, codec)

    ensures:
        JsonEncodeCompleted(json: String)
        -- Never throws (codec.encode is total)
}

rule JsonDecode {
    when: JsonDecodeRequested(json, codec)

    ensures:
        if codec.decode(json).outcome = success:
            JsonDecodeCompleted(value: codec.decode(json).value)
        else:
            JsonDecodeCompleted(error: codec.decode(json).error)
        -- Never throws; errors expressed as Left(JsonDecodeException)
        -- decode(null) returns Left(JsonDecodeException("null input"))
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant ScopeContainment {
    -- A capability with status = open cannot outlive its DaprScope.
    -- If scope.status = closed then cap.status = closed for all capabilities
    -- derived from that scope. Enforced by the Scala capture checker:
    -- capability types carry ^{scope}, preventing escape.
    for cap in StateCapability where cap.status = open:
        cap.scope.status = open
    for cap in PubSubCapability where cap.status = open:
        cap.scope.status = open
    for cap in ServiceInvocationCapability where cap.status = open:
        cap.scope.status = open
    for cap in SecretsCapability where cap.status = open:
        cap.scope.status = open
    for cap in ConfigurationCapability where cap.status = open:
        cap.scope.status = open
    for cap in BindingsCapability where cap.status = open:
        cap.scope.status = open
    for cap in DistributedLockCapability where cap.status = open:
        cap.scope.status = open
}

invariant ClientLifetime {
    -- The JavaDaprClient exists iff DaprRuntime is active.
    DaprRuntime.status = active <-> DaprRuntime.client != absent
}

invariant ScopeLifetime {
    -- DaprScope is open iff DaprRuntime is active.
    DaprRuntime.status = active <-> DaprScope.status = open
}

invariant ClosedCapabilityRejection {
    -- Operations on closed capabilities are rejected.
    -- Any operation requested on a capability with status = closed
    -- results in IllegalStateException, not a DAPR call.
    -- This is enforced at runtime by impl classes annotated @scala.caps.assumeSafe.
    -- The @scala.caps.assumeSafe annotation (from scala.caps package) is applied to
    -- non-safe-mode classes/objects so safe-mode user code can invoke them.
}

invariant TransactionAtomicity {
    -- A state transaction either fully succeeds or fully fails.
    -- No partial application is observable.
}

invariant ETagOptimisticConcurrency {
    -- saveWithETag and deleteWithETag succeed only when the provided ETag
    -- matches the current server-side ETag for that key.
    -- On mismatch, ETagMismatchException is thrown and no mutation occurs.
}

invariant PublishAtLeastOnce {
    -- PubSubPublish completing successfully means DAPR has accepted the message.
    -- Delivery to subscribers is at-least-once (DAPR guarantee, not this library's).
}

invariant JsonCodecRoundtrip {
    -- For any value v of type T with given JsonCodec[T]:
    -- JsonCodec.decode(JsonCodec.encode(v)) = Right(v)
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor UserCode {
    -- Safe-mode Scala code written by library users.
    -- May only interact with the library through declared surfaces.
    -- Cannot use @assumeSafe, cannot access JavaDaprClient directly.
}

actor LibraryAuthor {
    -- Non-safe-mode Scala code in internal/ package and DaprRuntime/JsonCodec.
    -- Responsible for @scala.caps.assumeSafe correctness.
    -- Annotates classes and objects with @scala.caps.assumeSafe (from scala.caps package)
    -- to permit safe-mode user code to call them through the public trait interfaces.
    -- Has access to JavaDaprClient.
    -- Cannot add @scala.caps.assumeSafe from within safe-mode files.
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface DaprRuntimeSurface {
    facing user: UserCode

    contracts:
        demands JsonCodec

    exposes:
        run: (body: DaprScope ?=> Any) -> Any
        -- Acquires a DaprClient, provides DaprScope to body, releases on exit.
        -- Propagates exceptions after releasing resources.
        -- DaprRuntime object is annotated @scala.caps.assumeSafe so safe-mode
        -- user code can call it without violating safe-mode constraints.

        serve: (app_port: Int, body: DaprScope ?=> DaprApp) -> Unit
        -- Starts an HTTP server on app_port; body returns a DaprApp describing
        -- all inbound handlers.  The server is started from the returned DaprApp,
        -- then blocks until the JVM shuts down or the calling thread is interrupted.
        -- DaprClient lifecycle matches the server's lifetime.

        run_with_endpoints: (http_endpoint: String, grpc_endpoint: String, body: DaprScope ?=> Any) -> Any
        -- Like run but overrides the DAPR sidecar HTTP and gRPC endpoints.
        -- Intended for integration tests where the sidecar runs on a
        -- non-default port (e.g. via Testcontainers).
        -- Endpoint overrides are reset to their original values on exit,
        -- whether the body completes normally or throws.

    @guarantee ResourceCleanup
        -- DaprRuntime.run, serve, and run_with_endpoints always close the DaprClient
        -- on exit, whether the body completes normally or throws.
}

surface StateCapabilitySurface {
    facing user: UserCode

    contracts:
        demands JsonCodec

    exposes:
        get: (key: String) -> Any
        -- Returns Option[T]; None if key not found
        get_with_etag: (key: String) -> StateEntry
        -- Returns StateEntry with value and current ETag
        get_bulk: (keys: List<String>) -> Map<String, StateEntry>
        -- Batch fetch; missing keys return StateEntry with value = absent
        save: (key: String, value: Any) -> Unit
        save_with_etag: (key: String, value: Any, etag: ETag) -> Unit
        save_bulk: (entries: List<Pair<String, Any>>) -> Unit
        delete: (key: String) -> Unit
        delete_with_etag: (key: String, etag: ETag) -> Unit
        transaction: (ops: List<StateOp>) -> Unit
        query_state: (query: StateQuery) -> List<StateEntry>
        -- Query using DAPR state store query API (store must support queries)

    @guarantee AtomicTransaction
        -- transaction applies all operations or none.
}

surface PubSubCapabilitySurface {
    facing user: UserCode

    contracts:
        demands JsonCodec

    exposes:
        publish: (topic: Topic, data: Any) -> Unit
        publish_with_metadata: (topic: Topic, data: Any, metadata: Map<String, String>) -> Unit
        bulk_publish: (topic: Topic, entries: List<BulkPublishEntry>) -> BulkPublishResult
        -- Publishes multiple entries in a single call; returns list of failed entry IDs
}

surface ServiceInvocationSurface {
    facing user: UserCode

    contracts:
        demands JsonCodec

    exposes:
        invoke: (app_id: AppId, method: String, data: Any) -> Any
        invoke_get: (app_id: AppId, method: String) -> Any
}

surface SecretsSurface {
    facing user: UserCode

    exposes:
        get: (key: String) -> String
        get_bulk: () -> Map<String, String>
}

surface ConfigurationSurface {
    facing user: UserCode

    exposes:
        get: (keys: List<String>) -> Map<String, ConfigItem>
        subscribe: (keys: List<String>, on_change: ConfigUpdate -> Unit) -> AutoCloseable
        -- Streams config changes from sidecar; close the AutoCloseable to stop
}

surface DaprAppSurface {
    facing user: UserCode

    contracts:
        demands JsonCodec

    exposes:
        Subscription: (pubsub_name: PubSubName, topic: Topic, handler: CloudEvent -> SubscriptionResult) -> Subscription
        Subscription_route: (pubsub_name: PubSubName, topic: Topic, route: Route, handler: CloudEvent -> SubscriptionResult) -> Subscription
        InvocationRoute: (method_name: MethodName, handler: Req -> Resp) -> InvocationRoute
        BindingRoute: (binding_name: BindingName, handler: Payload -> Unit) -> BindingRoute
        DaprApp: (subscriptions, invocations, bindings, workflows, activities) -> DaprApp
        ++: (DaprApp, DaprApp) -> DaprApp
        -- Handler lambdas may capture capabilities from the enclosing DaprScope.
        -- The recommended pattern is: business logic in explicit methods with
        -- (using cap: Capability) parameters; thin lambdas wrap each call in
        -- try/catch for CC CanThrow isolation (see DESIGN.md — Handler Pattern).

    @guarantee SubscriptionDiscovery
        -- GET /dapr/subscribe returns all registered pub/sub subscriptions
        -- before any request is handled

    @guarantee CapabilityLifetime
        -- Capabilities captured by handler lambdas share the DaprScope lifetime.
        -- Invocations after scope closure result in IllegalStateException
        -- (ClosedCapabilityRejection invariant).

    @guarantee Composability
        -- DaprApp ++ merges all lists from both apps; no handler is lost or duplicated.
}

surface BindingsSurface {
    facing user: UserCode

    contracts:
        demands JsonCodec

    exposes:
        invoke: (operation: String, data: Any) -> Any?
        -- Returns Option[Resp]; None if binding has no response
        invoke_one_way: (operation: String, data: Any) -> Unit
        -- Fire-and-forget binding invocation; no response expected
}

surface DistributedLockSurface {
    facing user: UserCode

    exposes:
        try_lock: (resourceId: String, lockOwner: String, expirySeconds: Int) -> Boolean
        -- Attempts to acquire lock; returns true if acquired, false if already held
        unlock: (resourceId: String, lockOwner: String) -> UnlockStatus
        -- Releases lock; returns Success, LockNotFound, or InternalError (wrong owner)
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Should DaprRuntime support a custom DaprClient (e.g. for testing without sidecar)?"
-- Current design always creates a fresh client via DaprClientBuilder.
-- An override for tests would allow passing a mock client.

