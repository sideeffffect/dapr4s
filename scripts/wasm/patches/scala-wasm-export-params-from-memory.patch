+  /** Loads the parameters of a lifted (exported) function from linear memory.
+   *
+   *  When the flattened parameters exceed MAX_FLAT_PARAMS (16), the canonical ABI passes a single
+   *  i32 pointer to a tuple of all parameters (`lift_flat_values`: `ptr = vi.next('i32')`,
+   *  `load(cx, ptr, TupleType(ts))`). Each parameter is aligned to its own alignment and the values
+   *  are left on the Wasm stack in declaration order, like `genLoadStack` does.
+   */
+  def genLoadParamsFromMemory(fb: FunctionBuilder, paramTypes: List[wit.ValType],
+      paramsPtr: wanme.LocalID)(implicit ctx: WasmContext): Unit = {
+    val ptr = fb.addLocal(NoOriginalName, watpe.Int32)
+    fb += wa.LocalGet(paramsPtr)
+    fb += wa.LocalSet(ptr)
+    for (tpe <- paramTypes) {
+      genAlignTo(fb, WitTypeOps.alignment(tpe), ptr)
+      fb += wa.LocalGet(ptr)
+      genLoadMemory(fb, tpe)
+      genMovePtr(fb, ptr, WitTypeOps.elemSize(tpe))
+    }
+  }
+
